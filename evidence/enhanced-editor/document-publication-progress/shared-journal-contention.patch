+"""Temporary host mutex contention only; never accesses an Amiga or shared runtime."""
+import errno
+import fcntl
+import os
+from pathlib import Path
+import tempfile
+import threading
+import time
+import unittest
+from unittest import mock
+import launcher_guard as g
+
+class JournalContention(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup)
+        self.root=Path(self.tmp.name).resolve()
+        self.guard=g.initialize(self.root,[],{'mode':'temporary-fixture','approved':True,
+            'legacy_holds_verified':True,'record_sha256':'1'*64})
+        self.lease=self.guard.reserve('emulator','fixture','bounded host mutex test')
+        self.effects=[];self.errors=[]
+    def worker(self):
+        try:
+            with g.LauncherGuard(self.root).operation(self.lease,'emulator','one effect'):
+                self.effects.append('once')
+        except BaseException as e:self.errors.append(e)
+    def blocked(self, mutation=None):
+        waiting=threading.Event();sleep=time.sleep
+        def observed_sleep(seconds):waiting.set();sleep(seconds)
+        with mock.patch.object(g.time,'sleep',side_effect=observed_sleep):
+            with self.guard._locked() as (fd,state):
+                thread=threading.Thread(target=self.worker);thread.start()
+                self.assertTrue(waiting.wait(1));self.assertEqual(self.effects,[])
+                if mutation:mutation(fd,state)
+            thread.join(2);self.assertFalse(thread.is_alive())
+    def test_brief_contention_dispatches_once_after_unlock(self):
+        self.blocked();self.assertEqual(self.effects,['once']);self.assertEqual(self.errors,[])
+        self.assertEqual(self.guard.status()['phase'],'READY')
+    def test_fresh_hold_after_wait_prevents_dispatch(self):
+        self.blocked(lambda fd,state:self.guard._hold_locked(fd,state,'new owner uncertainty'))
+        self.assertEqual(self.effects,[]);self.assertIsInstance(self.errors[0],g.GuardRefused)
+        self.assertEqual(len(self.guard.status()['holds']),1)
+    def test_replaced_lock_cannot_admit_old_inode(self):
+        def replace(fd,state):
+            p=self.guard.path/'lock';p.unlink();p.write_bytes(b'');p.chmod(0o600)
+        self.blocked(replace);self.assertEqual(self.effects,[])
+        self.assertIsInstance(self.errors[0],g.GuardRefused)
+        self.assertIn('lock changed',str(self.errors[0]))
+    def test_lock_permission_change_during_wait_refuses(self):
+        self.blocked(lambda fd,state:(self.guard.path/'lock').chmod(0o644))
+        self.assertEqual(self.effects,[]);self.assertIsInstance(self.errors[0],g.GuardRefused)
+    def test_sustained_contention_is_bounded_without_state_change(self):
+        raw=(self.guard.path/'state.json').read_bytes()
+        with (self.guard.path/'lock').open('r+b') as locked:
+            fcntl.flock(locked,fcntl.LOCK_EX|fcntl.LOCK_NB)
+            started=time.monotonic();self.worker();elapsed=time.monotonic()-started
+        self.assertGreaterEqual(elapsed,0.45);self.assertLess(elapsed,1.5)
+        self.assertEqual(self.effects,[]);self.assertEqual(len(self.errors),1)
+        self.assertEqual((self.guard.path/'state.json').read_bytes(),raw)
+    def test_noncontention_io_error_is_not_retried(self):
+        with mock.patch.object(g.fcntl,'flock',side_effect=OSError(errno.EIO,'injected')) as call:
+            self.worker()
+        self.assertEqual(call.call_count,1);self.assertEqual(self.effects,[])
+        self.assertIsInstance(self.errors[0],g.GuardRefused)
+
+if __name__=='__main__':unittest.main()
