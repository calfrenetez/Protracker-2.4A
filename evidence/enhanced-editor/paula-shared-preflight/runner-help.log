                                    --invert-cli REFERENCE_WAV |
                                    --invert-bounce | --invert-editor |
                                    --invert-sampler | --invert-session |
                                    --invert-render |
                                    --stem-cli REFERENCE_DIRECTORY |
                                    --render-cli REFERENCE_WAV |
                                    --pp20-import | --project-import |
                                    --recovery-file | --capture-memory |
                                    --capture-session-memory |
                                    --amigus-capture-memory |
                                    --editor-capture-memory |
                                    --paula-memory {cache,voices,preflight} |
                                    --sample-dispatch | --source-memory |
                                    --mod-import |
                                    --sample-import {raw,wav,svx} |
                                    --mod-stream | --project-stream |
                                    --sample-svx | --sample-raw |
                                    --sample-wav | --amigus-discovery |
                                    --studio-memory {native-abi,mixer,sampler,song,editor,queued,consumer,fifo,session,register-session,reserved-session,sample-ram,wavetable-cache,sampler-wavetable,wavetable-voices,wavetable-dispatch,editor-wavetable,render-sequence} |
                                    --input-memory {import,recent,exec-import,exec-recent} |
